<Window x:Class="Trace.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="迹 · Trace" Width="1040" Height="800" MinWidth="930" MinHeight="680" WindowStartupLocation="CenterScreen" Icon="Assets/Trace.ico">
  <Grid x:Name="Root" Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}">
      <DockPanel Margin="18,26,18,18">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,36">
          <StackPanel Orientation="Horizontal"><Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentBrush}"><Path Data="M 0,0 L 0,24 L 6,18 L 12,28 L 17,25 L 11,16 L 21,16 Z" Fill="{DynamicResource SidebarBrush}" Stretch="Uniform" Width="23" Height="27"/></Border><StackPanel Margin="12,-2,0,0"><TextBlock Text="迹" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="T R A C E" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="8,0,8,10"/>
          <TextBlock Text="每一次移动，都有迹可循。" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,12"/>
          <Button Content="↙  切换悬浮窗" Click="CompactClick" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="你的数字足迹" Style="{StaticResource Muted}" Margin="14,0,0,12"/>
          <Button x:Name="OverviewNav" Content="◈    概览" Tag="overview" Style="{StaticResource Navigation}" Click="NavigateClick"/>
          <Button x:Name="KeyboardNav" Content="⌨    键盘热力" Tag="keyboard" Style="{StaticResource Navigation}" Click="NavigateClick"/>
          <Button x:Name="WordsNav" Content="◌    词语画像" Tag="words" Style="{StaticResource Navigation}" Click="NavigateClick"/>
          <Button x:Name="SettingsNav" Content="☷    设置与隐私" Tag="settings" Style="{StaticResource Navigation}" Click="NavigateClick"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,20">
        <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="今天，也在创造。" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="{DynamicResource QuietBrush}" CornerRadius="8" Padding="3" Margin="8,0,12,0"><StackPanel Orientation="Horizontal"><RadioButton Content="今天" Tag="today" GroupName="Period" IsChecked="True" Click="PeriodChanged"/><RadioButton Content="累计" Tag="all" GroupName="Period" Click="PeriodChanged"/></StackPanel></Border>
            <Button Content="{Binding PauseText}" Click="PauseClick"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer x:Name="RootScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,18">
        <StackPanel>
          <Border Background="{DynamicResource QuietBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,16" Visibility="{Binding HasStorageError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding StorageError}" Foreground="{DynamicResource SecondaryBrush}"/></Border>
          <StackPanel x:Name="OverviewPage">
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="鼠标行走距离" Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,18,0,16"><TextBlock Text="{Binding DistanceText}" FontSize="48" FontWeight="SemiBold"/><TextBlock Text="{Binding DistanceUnit}" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,9"/></StackPanel><TextBlock Text="屏幕上的每一小步" Style="{StaticResource Muted}"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="键盘敲击次数" Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,18,0,16"><TextBlock Text="{Binding KeyText}" FontSize="48" FontWeight="SemiBold"/><TextBlock Text="次" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,9"/></StackPanel><TextBlock Text="灵感从指尖出发" Style="{StaticResource Muted}"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><DockPanel><TextBlock Text="活跃时刻" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><ItemsControl ItemsSource="{Binding Hours}" Height="154" Margin="0,16,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel VerticalAlignment="Bottom" Margin="2,0"><Border Height="{Binding Height}" Background="{DynamicResource AccentBrush}" CornerRadius="3" Opacity="0.7" ToolTip="{Binding Tip}"/><TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Height="20" Margin="0,8,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="指尖偏好" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding TopKeys}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="开始键入，查看你的常用按键。" Style="{StaticResource Muted}" Visibility="{Binding NoKeys, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="最近在表达什么" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Words}" MaxHeight="192" ClipToBounds="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource QuietBrush}" CornerRadius="7" Padding="8" Margin="0,0,7,7"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource WordBrush}" FontSize="17"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding WordEmptyText}" Style="{StaticResource Muted}" Visibility="{Binding NoWords, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
            </Grid>
          </StackPanel>
          <StackPanel x:Name="KeyboardPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><DockPanel><TextBlock Text="按键热力图" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="颜色越深，使用越频繁" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="KeyboardRows" Margin="0,20,0,4"/></ScrollViewer><TextBlock Text="主要 ANSI 键位示意 · 忽略长按自动重复 · 其他按键可在排行中查看" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="按键使用排行" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Rankings}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding CountText}" Grid.Column="1" Foreground="{DynamicResource SecondaryBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="还没有按键统计" Style="{StaticResource Muted}" Visibility="{Binding NoKeys, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="WordsPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="词语画像" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding TextStatus}" Style="{StaticResource Muted}" Margin="0,8,0,16"/><StackPanel Orientation="Horizontal"><StackPanel Margin="0,0,42,0"><TextBlock Text="识别字符" Style="{StaticResource Muted}"/><TextBlock Text="{Binding CharacterText}" FontSize="32" Margin="0,8,0,0"/></StackPanel><StackPanel><TextBlock Text="不同词语" Style="{StaticResource Muted}"/><TextBlock Text="{Binding WordCountText}" FontSize="32" Margin="0,8,0,0"/></StackPanel></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="你的高频词" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/><ItemsControl ItemsSource="{Binding Words}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource QuietBrush}" CornerRadius="10" Padding="13,10" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="{Binding FontSize}" Foreground="{DynamicResource WordBrush}"/><TextBlock Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,3"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding WordEmptyText}" Style="{StaticResource Muted}" Visibility="{Binding NoWords, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="仅展示汇总词频，不保存原始段落或输入时间线。" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="外观主题" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="面板与悬浮条同步切换，记住你的选择。" Style="{StaticResource Muted}" Margin="0,8,0,12"/><ComboBox x:Name="ThemeChoice" Width="240" HorizontalAlignment="Left" SelectionChanged="ThemeChanged"><ComboBoxItem Content="浅色 · 淡木" Tag="light"/><ComboBoxItem Content="深色 · 夜色" Tag="dark"/></ComboBox></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="输入与隐私" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,8,0,2"/><CheckBox x:Name="WordToggle" Content="开启中英文词语画像（默认关闭）" Checked="WordTrackingChanged" Unchecked="WordTrackingChanged"/><TextBlock Text="通过 Windows UI Automation 读取受支持输入框的变化，仅在本机分词。跳过密码标记与安全桌面；终端及常见密码管理器默认排除。自定义控件、浏览器、管理员权限窗口和输入法可能影响兼容性及归因。处理敏感内容时请暂停或排除应用。" Style="{StaticResource Muted}" LineHeight="21"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="排除应用" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="按进程文件名排除键盘与文字统计；鼠标距离仍累计。" Style="{StaticResource Muted}" Margin="0,8,0,12"/><ListBox x:Name="ExcludedList" ItemsSource="{Binding Excluded}" Height="146"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ExcludedName" ToolTip="例如 chrome.exe"/><Button Grid.Column="1" Content="添加" Click="AddExcludedClick" Margin="8,0,0,0"/><Button Grid.Column="2" Content="选择应用…" Click="BrowseExcludedClick" Margin="8,0,0,0"/></Grid><Button Content="移除所选排除项" Click="RemoveExcludedClick" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="本地数据" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="不联网、不遥测，每 10 秒保存；词频也可能包含私人信息。" Style="{StaticResource Muted}" Margin="0,8,0,10"/><TextBlock Text="{Binding StoragePath}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><WrapPanel Margin="0,14,0,0"><Button Content="导出 JSON…" Click="ExportClick" Margin="0,0,8,8"/><Button Content="清空词语画像" Click="ClearWordsClick" Margin="0,0,8,8"/><Button Content="清空全部统计" Click="ClearAllClick" Margin="0,0,0,8"/></WrapPanel><Button Content="备份原文件并重试保存" Click="RecoverClick" HorizontalAlignment="Left" Visibility="{Binding HasStorageError, Converter={StaticResource BoolVisibility}}"/></StackPanel></Border>
            <TextBlock Text="迹 · Trace for Windows 0.1.0  ·  MIT 开源  ·  关闭主面板会收起，退出请使用托盘菜单。" Style="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="28,0"><TextBlock Text="◈  所有统计仅保存在这台电脑上" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="T R A C E  /  W I N D O W S" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
  </Grid>
</Window>
