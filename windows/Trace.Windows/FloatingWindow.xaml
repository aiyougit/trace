<Window x:Class="Trace.Windows.FloatingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Trace 悬浮条" Width="220" Height="44" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" MouseLeftButtonDown="DragOrExpand">
  <Border x:Name="Root" Background="{DynamicResource FloatingBrush}" BorderThickness="1" CornerRadius="12" Padding="12,0" ToolTip="今日鼠标距离 / 键盘输入次数 · 拖动移动 · 双击展开 · 右键菜单">
    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Paused}" Value="True"><Setter Property="BorderBrush" Value="#CE9550"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Border.ContextMenu><ContextMenu><MenuItem Header="展开统计面板" Click="ExpandClick"/><MenuItem Header="{Binding PauseText}" Click="PauseClick"/><Separator/><MenuItem Header="隐藏悬浮条" Click="HideClick"/><MenuItem Header="退出 Trace" Click="ExitClick"/></ContextMenu></Border.ContextMenu>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="↗" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Width="76" MaxHeight="26"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TodayDistance}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding TodayUnit}" FontSize="10" Margin="4,5,0,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Viewbox></StackPanel>
      <Border Grid.Column="1" Height="17" Background="{DynamicResource LineBrush}"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0"><TextBlock Text="⌨" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Width="69" MaxHeight="26"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TodayKeys}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock Text="次" FontSize="10" Margin="4,5,0,0" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel></Viewbox></StackPanel>
    </Grid>
  </Border>
</Window>
